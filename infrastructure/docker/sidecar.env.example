# Local docker-compose sidecar defaults.
#
# Copy or source this file only for local smoke testing. Do not commit real
# deployment secrets.
#
# docker-compose.yml mounts:
# - infrastructure/docker/config/server.toml -> /etc/hl7v2/server.toml
# - profiles/ -> /var/lib/hl7v2/profiles/
# - hl7v2-bundles volume -> /var/lib/hl7v2/bundles
# - hl7v2-quarantine volume -> /var/lib/hl7v2/quarantine
#
# Override the mounted config file when you need different roots or profiles.
# Keep those roots configured by the server; request bodies should send safe
# bundle ids and inline messages, not server filesystem paths.

HL7V2_API_KEY=dev-secret
HL7V2_SERVER_URL=http://127.0.0.1:8080

# Source-checkout defaults for running `hl7v2-server` or
# `hl7v2-cli serve --mode grpc` outside Docker.
HL7V2_CONFIG=target/hl7v2-sidecar/server.toml
HL7V2_PROFILE_PATHS=profiles/generic.yaml
HL7V2_BUNDLE_OUTPUT_ROOT=target/hl7v2-sidecar/bundles
