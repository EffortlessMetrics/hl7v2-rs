{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.hl7v2-rs.org/evidence/doctor-report/v2",
  "title": "HL7v2 Doctor Report v2",
  "description": "Machine-readable first-run diagnostic report with embedded evidence provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_name", "tool_version", "version", "checks"],
  "properties": {
    "schema_version": {"const": "2"},
    "tool_name": {
      "type": "string",
      "enum": ["hl7v2-cli"]
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/doctor_check"
      }
    }
  },
  "definitions": {
    "doctor_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "message"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["ok", "warn", "error"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
