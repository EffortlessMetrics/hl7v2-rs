{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.hl7v2-rs.org/evidence/safe-analysis-redaction-output/v2",
  "title": "HL7v2 Safe-Analysis Redaction Output v2",
  "description": "Target v2 safe-analysis redaction output with top-level evidence provenance and a v2 redaction receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_name",
    "tool_version",
    "input_sha256",
    "policy_sha256",
    "message_type",
    "redacted_hl7",
    "receipt"
  ],
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "tool_name": {
      "type": "string",
      "enum": ["hl7v2-cli", "hl7v2-python"]
    },
    "tool_version": {
      "type": "string"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "message_type": {
      "type": "string"
    },
    "redacted_hl7": {
      "type": "string"
    },
    "receipt": {
      "$ref": "#/definitions/redaction_receipt_v2"
    }
  },
  "definitions": {
    "redaction_receipt_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tool_name",
        "tool_version",
        "phi_removed",
        "hash_algorithm",
        "actions"
      ],
      "properties": {
        "schema_version": {
          "const": "2"
        },
        "tool_name": {
          "type": "string",
          "enum": ["hl7v2-cli", "hl7v2-python"]
        },
        "tool_version": {
          "type": "string"
        },
        "phi_removed": {
          "type": "boolean"
        },
        "hash_algorithm": {
          "type": "string",
          "enum": ["sha256"]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/redaction_action"
          }
        }
      }
    },
    "redaction_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "action",
        "reason",
        "matched_count",
        "optional",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": ["hash", "drop", "retain"]
        },
        "reason": {
          "type": "string"
        },
        "matched_count": {
          "type": "integer",
          "minimum": 0
        },
        "optional": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["applied", "retained", "not_found"]
        }
      }
    }
  }
}
