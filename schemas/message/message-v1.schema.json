{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.hl7v2-rs.org/message/v1",
  "title": "HL7v2 Canonical Message JSON",
  "description": "JSON representation emitted by hl7v2::writer::json",
  "type": "object",
  "required": ["meta", "segments"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["delims"],
      "properties": {
        "charsets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delims": {
          "type": "object",
          "required": ["field", "comp", "rep", "esc", "sub"],
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1
            },
            "comp": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1
            },
            "rep": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1
            },
            "esc": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1
            },
            "sub": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fields"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "$ref": "https://example.org/schemas/hl7v2/segment_field.schema.json"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
